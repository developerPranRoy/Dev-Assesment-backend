# =============================================================================
#  Environment configuration — copy to .env and fill in secrets
#  All values here are safe defaults or placeholders — never commit .env
# =============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Which set of routes this process serves.
# Values: all | auth | core | exam | payment
# In docker-compose each container sets this to its own service name.
SERVICE_NAME=all

# ── Database ───────────────────────────────────────────────────────────────────
# App traffic goes through PgBouncer (transaction pool). Keep connection_limit
# small — PgBouncer multiplexes to the real Postgres pool.
DATABASE_URL=postgresql://postgres:CHANGE_ME@pgbouncer:6432/dev_assessment_platform?pgbouncer=true&connection_limit=5&pool_timeout=10

# Prisma migrations and introspection need a direct connection, bypassing PgBouncer.
DIRECT_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/dev_assessment_platform

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-64-char-string-a
JWT_ACCESS_EXPIRES_IN=15m

# Must be different from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=replace-with-a-random-64-char-string-b
JWT_REFRESH_EXPIRES_IN=30d

# ── Bcrypt ─────────────────────────────────────────────────────────────────────
# 12 is the recommended production value (balance of security & latency)
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting ──────────────────────────────────────────────────────────────
# windowMs: 15 minutes in ms
RATE_LIMIT_WINDOW_MS=900000
# General API: 1000 requests per window per IP
RATE_LIMIT_MAX=1000
# Auth endpoints: 20 attempts per window (brute-force protection)
RATE_LIMIT_AUTH_MAX=20

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
# In production: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:80/api/v1/auth/google/callback

# ── Judge0 (code execution) ────────────────────────────────────────────────────
# URL of your self-hosted or CE Judge0 instance
JUDGE0_API_URL=

# Max simultaneous HTTP calls to Judge0 per grading job
JUDGE0_CONCURRENCY=4

# Per-request timeout in ms
JUDGE0_TIMEOUT_MS=15000

# ── BullMQ worker ──────────────────────────────────────────────────────────────
# Number of grading jobs processed in parallel per worker process
WORKER_CONCURRENCY=8

# ── CORS ───────────────────────────────────────────────────────────────────────
# In production set to your actual frontend origin(s), comma-separated
CORS_ORIGIN=https://yourdomain.com

# ── Frontend ───────────────────────────────────────────────────────────────────
# Used to build the redirect URL after Google OAuth
FRONTEND_URL=https://yourdomain.com

# ── Cookies ────────────────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=true

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_SUCCESS_URL=https://yourdomain.com/payment/success
STRIPE_CANCEL_URL=https://yourdomain.com/payment/cancel

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Business logic ─────────────────────────────────────────────────────────────
# How many credits are consumed per candidate invitation
CREDITS_PER_INVITATION=1

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Email (Nodemailer) ─────────────────────────────────────────────────────────
# Dev:  Mailtrap (mailtrap.io) or Ethereal (ethereal.email)
# Prod: SendGrid, AWS SES, Resend, Postmark
# Leave blank — invitations still created; token returned in API response.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
