    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment (owner only) \u2014 returns a real Stripe checkoutUrl",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credits\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/initiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "initiate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data;",
                  "  pm.collectionVariables.set('paymentId', data.payment.id);",
                  "  pm.collectionVariables.set('transactionId', data.payment.transactionId);",
                  "  console.log('Open this to pay:', data.checkoutUrl);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment Webhook (NOT testable from Postman \u2014 use Stripe CLI)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "Do not send this from Postman.\n\nStripe signs the exact raw request bytes, so a hand-crafted request here will always fail signature verification with a 400.\n\nTo test for real:\n1. Install the Stripe CLI\n2. Run: stripe listen --forward-to localhost:5000/api/v1/payments/webhook\n3. Put the printed whsec_... value into STRIPE_WEBHOOK_SECRET\n4. Run 'Initiate Payment', open the returned checkoutUrl, pay with test card 4242 4242 4242 4242\n\nThe CLI forwards the real, correctly-signed event to your local server automatically."
            },
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "webhook"
              ]
            }
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          }
        }
      ]
    },
