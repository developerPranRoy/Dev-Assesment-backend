{
  "info": {
    "name": "Developer Assessment & Coding Platform",
    "description": "Full API collection. Run a Login request first to populate {{accessToken}} \u2014 most requests inherit collection-level bearer auth. Seed data (from prisma:seed) pre-fills companyId and problemId; other IDs (assessmentId, attemptId, submissionId, paymentId, invitationToken) are captured automatically by test scripts on the request that creates them, as long as you run requests roughly top-to-bottom within a folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dev-assesment-backend.onrender.com/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "companyId",
      "value": "seed-company-acme"
    },
    {
      "key": "problemId",
      "value": "seed-problem-mcq"
    },
    {
      "key": "assessmentId",
      "value": ""
    },
    {
      "key": "attemptId",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
