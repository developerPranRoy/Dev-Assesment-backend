            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Candidate\",\n  \"email\": \"newcandidate@example.dev\",\n  \"password\": \"Password123!\",\n  \"role\": \"CANDIDATE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', data.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
